generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  AGENT
  CUSTOMER
  COMPLIANCE
  ADMIN
}

enum TradeStatus {
  REQUESTED // Customer initiated request
  INITIATED
  CUSTOMER_VERIFIED
  QUOTED
  SENT_TO_CUSTOMER
  CUSTOMER_CONFIRMED
  AWAITING_PAYMENT
  PAYMENT_UPLOADED
  PAYMENT_CONFIRMED
  FLAGGED
  UNDER_REVIEW
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportType {
  CTR
  STR
}

enum CommissionType {
  TRANSACTION
  REFERRAL
  BONUS
}

enum CommissionStatus {
  PENDING
  PAID
  DISPUTED
}

enum KycStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMITTED
}

// ---------- CORE ----------

model User {
  id        String   @id @default(uuid())
  role      Role
  email     String?  @unique
  phone     String
  password  String
  firstName String?
  lastName  String?
  isActive              Boolean   @default(true)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())

  agentProfile       AgentProfile?
  customer           Customer?
  commissions        Commission[]       @relation("AgentCommissions")
  agentNotes         CustomerNote[]     @relation("AgentNotes")
  notifications      Notification[]
  agentDocuments     CustomerDocument[] @relation("AgentDocuments")
  agentTrades        Trade[]            @relation("AgentTrades")
  agentTradeRequests TradeRequest[]     @relation("AgentTradeRequests")
  agentRatings       AgentRating[]      @relation("AgentRatings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String // INFO, WARNING, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Country {
  id       String @id @default(uuid())
  name     String
  isoCode  String
  currency String
}

// ---------- AGENTS ----------

model AgentProfile {
  userId                String    @id
  region                String
  lga                   String
  licenseId             String
  dailyLimit            Decimal
  monthlyLimit          Decimal
  homeAddress           String?
  dateOfBirth           DateTime?
  governmentIdUrl       String?
  proofOfAddressUrl     String?
  onboardingStatus      String    @default("PENDING") // PENDING, IN_PROGRESS, SUBMITTED, APPROVED
  onboardingToken       String?   @unique
  onboardingTokenExpiry DateTime?
  referralCode          String?   @unique
  agentType             String    @default("Field Agent")

  user User @relation(fields: [userId], references: [id])
}

// ---------- CUSTOMERS ----------

model Customer {
  id                String    @id @default(uuid())
  userId            String    @unique
  bvn               String
  fullName          String
  bankName          String?
  accountNo         String?
  email             String?
  phone             String?
  gender            String?
  dateOfBirth       DateTime?
  homeAddress       String?
  nin               String?
  companyName       String?
  companySector     String?
  governmentIdUrl   String?
  proofOfAddressUrl String?
  verified          Boolean   @default(false)
  kycStatus         KycStatus @default(NOT_SUBMITTED)
  kycRejectionReason String?
  kycReviewedAt     DateTime?
  kycReviewedBy     String?
  createdAt         DateTime  @default(now())

  // Referral attribution (no FK — agent may be deleted later)
  referringAgentId String?
  referralCode     String?
  referralType     String? // AGENT | CORPORATE | DIRECT

  user               User                    @relation(fields: [userId], references: [id])
  notes              CustomerNote[]
  documents          CustomerDocument[]
  trades             Trade[]                 @relation("CustomerTrades")
  bankDetails        CustomerBankDetails[]
  tradeRequests      TradeRequest[]
  suppliers          Supplier[]
  adminSupplierLinks AdminSupplierCustomer[]
  agentRatings       AgentRating[]
  feedbacks          CustomerFeedback[]

  @@index([referringAgentId])
}

model CustomerBankDetails {
  id            String   @id @default(uuid())
  customerId    String
  bankName      String
  accountName   String
  accountNumber String
  routingNumber String?
  swiftCode     String?
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model TradeRequest {
  id              String   @id @default(uuid())
  customerId      String
  agentId         String?
  amount          Decimal
  sendCurrency    String
  receiveCurrency String
  purpose         String?
  tradeType       String   @default("BUY") // BUY, SELL
  receiptUrl      String? // Receipt uploaded during initialization
  status          String   @default("PENDING") // PENDING, POOL, ASSIGNED, PROCESSED, REJECTED
  createdAt       DateTime @default(now())

  // Supplier details submitted by customer
  supplierId            String?
  supplierBusinessName  String?
  supplierBankName      String?
  supplierAccountNumber String?
  supplierSector        String?
  supplierAddress       String?
  invoiceUrl            String?

  fxRate       Decimal?
  payoutAmount Decimal?
  quotedAt     DateTime?

  // Negotiation fields (Sprint 2)
  negotiationUsed  Boolean   @default(false)
  originalFxRate   Decimal?
  negotiatedRate   Decimal?

  customer     Customer      @relation(fields: [customerId], references: [id])
  agent        User?         @relation("AgentTradeRequests", fields: [agentId], references: [id])
  chatMessages ChatMessage[]
}

model ChatMessage {
  id             String   @id @default(uuid())
  tradeId        String?
  tradeRequestId String?
  senderId       String
  message        String?
  imageUrl       String?
  fileUrl        String?
  role           String // CUSTOMER, AGENT, ADMIN
  createdAt      DateTime @default(now())

  trade        Trade?        @relation(fields: [tradeId], references: [id])
  tradeRequest TradeRequest? @relation(fields: [tradeRequestId], references: [id])
}

// ---------- CUSTOMER DOCUMENTS ----------

model CustomerDocument {
  id           String   @id @default(uuid())
  customerId   String
  agentId      String
  documentType String
  fileUrl      String
  fileName     String
  fileSize     Int
  status       String   @default("Pending Review")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  agent    User     @relation("AgentDocuments", fields: [agentId], references: [id])
}

// ---------- TRADES ----------

model Trade {
  id         String  @id @default(uuid())
  agentId    String
  customerId String
  countryId  String?

  tradeType       String    @default("BUY") // BUY, SELL
  sendCurrency    String
  receiveCurrency String
  amount          Decimal
  fxRate          Decimal?
  lockedUntil     DateTime?

  // Negotiation (one-time 0.05% discount per trade)
  originalFxRate  Decimal?
  negotiatedRate  Decimal?
  negotiationUsed Boolean   @default(false)

  status    TradeStatus
  createdAt DateTime    @default(now())

  // New fields for payment and payout details
  paymentAccountName   String?
  paymentAccountNumber String?
  paymentBankName      String?
  paymentAmount        Decimal?

  paymentMethod    String?
  paymentSource    String?
  payoutMethod     String?
  recipientName    String?
  recipientDetails String?
  payoutAmount     String?
  paymentProofUrl  String?
  payoutProofUrl   String?

  // Escrow / Admin Hold
  isCommissionFrozen Boolean @default(false)


  // Admin-managed fields
  tradeRequestId        String?
  receiptUrl            String?
  supplierBusinessName  String?
  supplierBankName      String?
  supplierAccountNumber String?
  supplierSector        String?
  supplierAddress       String?

  customer     Customer      @relation("CustomerTrades", fields: [customerId], references: [id])
  agent        User          @relation("AgentTrades", fields: [agentId], references: [id])
  commissions  Commission[]
  chatMessages ChatMessage[]
  agentRating  AgentRating?
}

// ---------- COMPLIANCE ----------

model ComplianceFlag {
  id        String   @id @default(uuid())
  tradeId   String
  reason    String
  severity  String
  createdAt DateTime @default(now())
}

model ComplianceReport {
  id        String     @id @default(uuid())
  tradeId   String
  type      ReportType
  data      Json
  createdAt DateTime   @default(now())
}

// ---------- APPROVALS ----------

model OverrideApproval {
  id          String         @id @default(uuid())
  tradeId     String
  requestedBy String
  approvedBy  String?
  status      ApprovalStatus @default(PENDING)
}

// ---------- AUDIT ----------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      Role
  action    String
  entity    String
  entityId  String
  ip        String
  metadata  Json?    // before/after for rate changes, negotiation details, etc.
  createdAt DateTime @default(now())
}

model NegotiationLog {
  id           String   @id @default(uuid())
  tradeId      String
  userId       String
  originalRate Decimal
  newRate      Decimal
  discount     Decimal
  createdAt    DateTime @default(now())

  @@index([tradeId])
  @@index([userId])
}

model FxMargin {
  id        String  @id @default(uuid())
  countryId String  @unique
  margin    Decimal
}

model SystemConfig {
  key   String @id
  value Json
}

// ---------- RATE CHANGE AUDIT ----------

model RateChangeLog {
  id            String   @id @default(uuid())
  pair          String
  previousBuy   Decimal
  previousSell  Decimal
  newBuy        Decimal
  newSell       Decimal
  changedBy     String
  reason        String?
  createdAt     DateTime @default(now())

  @@index([pair])
  @@index([changedBy])
}

// ---------- DAILY TURNOVER ----------

model DailyTurnover {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  totalVolume Decimal  @default(0)
  targetMet   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([date])
}

// ---------- COMMISSIONS ----------

model Commission {
  id            String           @id @default(uuid())
  reference     String           @unique
  agentId       String
  tradeId       String
  type          CommissionType
  amount        Decimal
  currency      String           @default("NGN")
  rate          Decimal?
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  payoutMethod  String?
  bankName      String?
  accountName   String?
  accountNumber String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  agent      User                 @relation("AgentCommissions", fields: [agentId], references: [id])
  trade      Trade                @relation(fields: [tradeId], references: [id])
  activities CommissionActivity[]
}

model CommissionActivity {
  id           String   @id @default(uuid())
  commissionId String
  action       String
  actorId      String?
  description  String
  createdAt    DateTime @default(now())

  commission Commission @relation(fields: [commissionId], references: [id])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  agentId    String
  content    String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  agent    User     @relation("AgentNotes", fields: [agentId], references: [id])
}

// ---------- SUPPLIERS ----------

// Customer self-service suppliers (beneficiary bank details)
model Supplier {
  id              String   @id @default(uuid())
  customerId      String
  beneficiaryName String
  bankName        String?
  accountNumber   String?
  iban            String?
  swiftBic        String?
  routingCode     String?
  currency        String?
  address         String?
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Admin-managed global supplier directory
model AdminSupplier {
  id            String   @id @default(uuid())
  businessName  String
  bankName      String
  accountNumber String
  sector        String
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedCustomers AdminSupplierCustomer[]
}

// Join table linking admin suppliers to customers
model AdminSupplierCustomer {
  id         String   @id @default(uuid())
  supplierId String
  customerId String
  createdAt  DateTime @default(now())

  supplier AdminSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([supplierId, customerId])
}

// ---------- MARKET DATA COLLECTION ----------

model MarketRate {
  id               String   @id @default(uuid())
  timestamp        DateTime
  source           String
  venue            String
  assetPair        String
  bid              Decimal
  ask              Decimal
  mid              Decimal
  spread           Decimal
  availableVolume  Decimal?
  minOrder         Decimal?
  maxOrder         Decimal?
  liquidityScore   Decimal?
  reliabilityScore Decimal?
  dataStatus       String   @default("valid")
  createdAt        DateTime @default(now())

  @@index([assetPair, source])
  @@index([timestamp])
}

model P2PQuote {
  id               String   @id @default(uuid())
  timestamp        DateTime
  source           String
  venue            String
  assetPair        String
  bid              Decimal
  ask              Decimal
  mid              Decimal
  spread           Decimal
  availableVolume  Decimal?
  minOrder         Decimal?
  maxOrder         Decimal?
  completionRate   Decimal?
  paymentMethod    String?
  merchantLimits   Json?
  liquidityScore   Decimal?
  reliabilityScore Decimal?
  dataStatus       String   @default("valid")
  createdAt        DateTime @default(now())

  @@index([assetPair, source])
  @@index([timestamp])
}

model LiquidityDepth {
  id               String   @id @default(uuid())
  timestamp        DateTime
  venue            String
  assetPair        String
  executableVolume Decimal
  bidDepth         Json?
  askDepth         Json?
  venueRanking     Int?
  createdAt        DateTime @default(now())

  @@index([venue, assetPair])
  @@index([timestamp])
}

// ---------- SPRINT 5 CUSTOMER FEEDBACK & RATINGS ----------

model AgentRating {
  id         String   @id @default(uuid())
  tradeId    String   @unique
  agentId    String
  customerId String
  rating     Int
  feedback   String?
  createdAt  DateTime @default(now())

  trade    Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  agent    User     @relation("AgentRatings", fields: [agentId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerFeedback {
  id         String   @id @default(uuid())
  customerId String
  category   String   @default("GENERAL") // GENERAL, SUGGESTION, COMPLAINT
  message    String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ---------- AGENT APPLICATIONS (public sign-up) ----------

model AgentApplication {
  id                     String   @id @default(uuid())
  fullName               String
  email                  String
  phone                  String
  country                String
  stateCity              String
  occupation             String
  linkedIn               String?
  hearAboutUs            String
  ownsOrOperatesBusiness Boolean
  whyAgent               String
  networkSize            String?
  status                 String   @default("PENDING") // PENDING, REVIEWED, APPROVED, REJECTED
  adminNotes             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status])
  @@index([email])
}
