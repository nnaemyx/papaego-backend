generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  AGENT
  CUSTOMER
  COMPLIANCE
  ADMIN
  ORG_OWNER
  ORG_ADMIN
}

enum TradeStatus {
  REQUESTED // Customer initiated request
  INITIATED
  CUSTOMER_VERIFIED
  QUOTED
  SENT_TO_CUSTOMER
  CUSTOMER_CONFIRMED
  AWAITING_PAYMENT
  PAYMENT_UPLOADED
  PAYMENT_CONFIRMED
  FLAGGED
  UNDER_REVIEW
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportType {
  CTR
  STR
}

enum CommissionType {
  TRANSACTION
  REFERRAL
  BONUS
}

enum CommissionStatus {
  PENDING
  PAID
  DISPUTED
}

enum KycStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMITTED
}

// ---------- SPRINT 1: ONBOARDING & COMPLIANCE ENUMS ----------

enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  REJECTED
}

enum QualificationOutcome {
  QUALIFIED
  MANUAL_REVIEW
  NOT_QUALIFIED
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  MANUAL_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  SELFIE
  PROOF_OF_ADDRESS
  CERTIFICATE_OF_INCORPORATION
  MEMORANDUM_OF_ASSOCIATION
  ARTICLES_OF_ASSOCIATION
  TAX_ID_DOCUMENT
  DIRECTOR_ID
  UBO_DOCUMENT
  OTHER
}

enum WebhookEvent {
  KYC_APPROVED
  KYC_REJECTED
  KYC_PROCESSING
  KYC_ADDITIONAL_INFO_REQUIRED
  KYC_EXPIRED
  KYB_APPROVED
  KYB_REJECTED
  KYB_PROCESSING
  KYB_ADDITIONAL_INFO_REQUIRED
  KYB_EXPIRED
}

// ---------- CORE ----------

model User {
  id                   String    @id @default(uuid())
  role                 Role
  email                String?   @unique
  phone                String
  password             String
  firstName            String?
  lastName             String?
  isActive             Boolean   @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())

  agentProfile       AgentProfile?
  customer           Customer?
  commissions        Commission[]       @relation("AgentCommissions")
  agentNotes         CustomerNote[]     @relation("AgentNotes")
  notifications      Notification[]
  agentDocuments     CustomerDocument[] @relation("AgentDocuments")
  agentTrades        Trade[]            @relation("AgentTrades")
  agentTradeRequests TradeRequest[]     @relation("AgentTradeRequests")
  agentRatings       AgentRating[]      @relation("AgentRatings")
  cashoutRequests    CashoutRequest[]

  // Sprint 1: Organization relations
  ownedOrganizations Organization[]       @relation("OrgOwner")
  orgMemberships     OrganizationMember[] @relation("OrgMembers")
  kycRequests        KycRequest[]         @relation("KycUser")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String // INFO, WARNING, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Country {
  id       String @id @default(uuid())
  name     String
  isoCode  String
  currency String
}

// ---------- AGENTS ----------

model AgentProfile {
  userId                String    @id
  region                String
  lga                   String
  licenseId             String
  dailyLimit            Decimal
  monthlyLimit          Decimal
  homeAddress           String?
  dateOfBirth           DateTime?
  governmentIdUrl       String?
  proofOfAddressUrl     String?
  onboardingStatus      String    @default("PENDING") // PENDING, IN_PROGRESS, SUBMITTED, APPROVED
  onboardingToken       String?   @unique
  onboardingTokenExpiry DateTime?
  referralCode          String?   @unique
  agentType             String    @default("Field Agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- CUSTOMERS ----------

model Customer {
  id                 String    @id @default(uuid())
  userId             String    @unique
  bvn                String
  fullName           String
  bankName           String?
  accountNo          String?
  email              String?
  phone              String?
  gender             String?
  dateOfBirth        DateTime?
  homeAddress        String?
  nin                String?
  companyName        String?
  companySector      String?
  governmentIdUrl    String?
  proofOfAddressUrl  String?
  verified           Boolean   @default(false)
  kycStatus          KycStatus @default(NOT_SUBMITTED)
  kycRejectionReason String?
  kycReviewedAt      DateTime?
  kycReviewedBy      String?
  createdAt          DateTime  @default(now())

  // Referral attribution (no FK — agent may be deleted later)
  referringAgentId String?
  referralCode     String?
  referralType     String? // AGENT | CORPORATE | DIRECT

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes              CustomerNote[]
  documents          CustomerDocument[]
  trades             Trade[]                 @relation("CustomerTrades")
  bankDetails        CustomerBankDetails[]
  tradeRequests      TradeRequest[]
  suppliers          Supplier[]
  adminSupplierLinks AdminSupplierCustomer[]
  agentRatings       AgentRating[]
  feedbacks          CustomerFeedback[]

  // Wallet (ledger balance) relations
  wallet          CustomerWallet?
  depositRequests DepositRequest[]

  @@index([referringAgentId])
}

model CustomerBankDetails {
  id            String   @id @default(uuid())
  customerId    String
  bankName      String
  accountName   String
  accountNumber String
  routingNumber String?
  swiftCode     String?
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model TradeRequest {
  id              String   @id @default(uuid())
  customerId      String
  agentId         String?
  amount          Decimal
  sendCurrency    String
  receiveCurrency String
  purpose         String?
  tradeType       String   @default("BUY") // BUY, SELL
  receiptUrl      String? // Receipt uploaded during initialization
  status          String   @default("PENDING") // PENDING, POOL, ASSIGNED, PROCESSED, REJECTED
  createdAt       DateTime @default(now())

  // Supplier details submitted by customer
  supplierId            String?
  supplierBusinessName  String?
  supplierBankName      String?
  supplierAccountNumber String?
  supplierSector        String?
  supplierAddress       String?
  invoiceUrl            String?

  fxRate       Decimal?
  payoutAmount Decimal?
  quotedAt     DateTime?

  // Negotiation fields (Sprint 2)
  negotiationUsed Boolean  @default(false)
  originalFxRate  Decimal?
  negotiatedRate  Decimal?

  customer     Customer      @relation(fields: [customerId], references: [id])
  agent        User?         @relation("AgentTradeRequests", fields: [agentId], references: [id])
  chatMessages ChatMessage[]
}

model ChatMessage {
  id             String   @id @default(uuid())
  tradeId        String?
  tradeRequestId String?
  senderId       String
  message        String?
  imageUrl       String?
  fileUrl        String?
  role           String // CUSTOMER, AGENT, ADMIN
  createdAt      DateTime @default(now())

  trade        Trade?        @relation(fields: [tradeId], references: [id])
  tradeRequest TradeRequest? @relation(fields: [tradeRequestId], references: [id])
}

// ---------- CUSTOMER DOCUMENTS ----------

model CustomerDocument {
  id           String   @id @default(uuid())
  customerId   String
  agentId      String
  documentType String
  fileUrl      String
  fileName     String
  fileSize     Int
  status       String   @default("Pending Review")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  agent    User     @relation("AgentDocuments", fields: [agentId], references: [id])
}

// ---------- TRADES ----------

model Trade {
  id         String  @id @default(uuid())
  agentId    String
  customerId String
  countryId  String?

  tradeType       String    @default("BUY") // BUY, SELL
  sendCurrency    String
  receiveCurrency String
  amount          Decimal
  fxRate          Decimal?
  lockedUntil     DateTime?

  // Negotiation (one-time 0.05% discount per trade)
  originalFxRate  Decimal?
  negotiatedRate  Decimal?
  negotiationUsed Boolean  @default(false)

  status    TradeStatus
  createdAt DateTime    @default(now())

  // New fields for payment and payout details
  paymentAccountName   String?
  paymentAccountNumber String?
  paymentBankName      String?
  paymentAmount        Decimal?

  paymentMethod    String?
  paymentSource    String?
  payoutMethod     String?
  recipientName    String?
  recipientDetails String?
  payoutAmount     String?
  paymentProofUrl  String?
  payoutProofUrl   String?

  // Escrow / Admin Hold
  isCommissionFrozen Boolean @default(false)

  // Admin-managed fields
  tradeRequestId        String?
  receiptUrl            String?
  supplierBusinessName  String?
  supplierBankName      String?
  supplierAccountNumber String?
  supplierSector        String?
  supplierAddress       String?

  customer     Customer      @relation("CustomerTrades", fields: [customerId], references: [id])
  agent        User          @relation("AgentTrades", fields: [agentId], references: [id])
  commissions  Commission[]
  chatMessages ChatMessage[]
  agentRating  AgentRating?
}

// ---------- COMPLIANCE ----------

model ComplianceFlag {
  id        String   @id @default(uuid())
  tradeId   String
  reason    String
  severity  String
  createdAt DateTime @default(now())
}

model ComplianceReport {
  id        String     @id @default(uuid())
  tradeId   String
  type      ReportType
  data      Json
  createdAt DateTime   @default(now())
}

// ---------- APPROVALS ----------

model OverrideApproval {
  id          String         @id @default(uuid())
  tradeId     String
  requestedBy String
  approvedBy  String?
  status      ApprovalStatus @default(PENDING)
}

// ---------- AUDIT ----------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  role      Role
  action    String
  entity    String
  entityId  String
  ip        String
  metadata  Json? // before/after for rate changes, negotiation details, etc.
  createdAt DateTime @default(now())
}

model NegotiationLog {
  id           String   @id @default(uuid())
  tradeId      String
  userId       String
  originalRate Decimal
  newRate      Decimal
  discount     Decimal
  createdAt    DateTime @default(now())

  @@index([tradeId])
  @@index([userId])
}

model FxMargin {
  id        String  @id @default(uuid())
  countryId String  @unique
  margin    Decimal
}

model SystemConfig {
  key   String @id
  value Json
}

// ---------- RATE CHANGE AUDIT ----------

model RateChangeLog {
  id           String   @id @default(uuid())
  pair         String
  previousBuy  Decimal
  previousSell Decimal
  newBuy       Decimal
  newSell      Decimal
  changedBy    String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([pair])
  @@index([changedBy])
}

// ---------- DAILY TURNOVER ----------

model DailyTurnover {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  totalVolume Decimal  @default(0)
  targetMet   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([date])
}

// ---------- COMMISSIONS ----------

model Commission {
  id            String           @id @default(uuid())
  reference     String           @unique
  agentId       String
  tradeId       String
  type          CommissionType
  amount        Decimal
  currency      String           @default("NGN")
  rate          Decimal?
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  payoutMethod  String?
  bankName      String?
  accountName   String?
  accountNumber String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  agent      User                 @relation("AgentCommissions", fields: [agentId], references: [id])
  trade      Trade                @relation(fields: [tradeId], references: [id])
  activities CommissionActivity[]
}

model CommissionActivity {
  id           String   @id @default(uuid())
  commissionId String
  action       String
  actorId      String?
  description  String
  createdAt    DateTime @default(now())

  commission Commission @relation(fields: [commissionId], references: [id])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  agentId    String
  content    String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  agent    User     @relation("AgentNotes", fields: [agentId], references: [id])
}

// ---------- SUPPLIERS ----------

// Customer self-service suppliers (beneficiary bank details)
model Supplier {
  id              String   @id @default(uuid())
  customerId      String
  beneficiaryName String
  bankName        String?
  accountNumber   String?
  iban            String?
  swiftBic        String?
  routingCode     String?
  currency        String?
  address         String?
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Admin-managed global supplier directory
model AdminSupplier {
  id            String   @id @default(uuid())
  businessName  String
  bankName      String
  accountNumber String
  sector        String
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedCustomers AdminSupplierCustomer[]
}

// Join table linking admin suppliers to customers
model AdminSupplierCustomer {
  id         String   @id @default(uuid())
  supplierId String
  customerId String
  createdAt  DateTime @default(now())

  supplier AdminSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([supplierId, customerId])
}

// ---------- MARKET DATA COLLECTION ----------

model MarketRate {
  id               String   @id @default(uuid())
  timestamp        DateTime
  source           String
  venue            String
  assetPair        String
  bid              Decimal
  ask              Decimal
  mid              Decimal
  spread           Decimal
  availableVolume  Decimal?
  minOrder         Decimal?
  maxOrder         Decimal?
  liquidityScore   Decimal?
  reliabilityScore Decimal?
  dataStatus       String   @default("valid")
  createdAt        DateTime @default(now())

  @@index([assetPair, source])
  @@index([timestamp])
}

model P2PQuote {
  id               String   @id @default(uuid())
  timestamp        DateTime
  source           String
  venue            String
  assetPair        String
  bid              Decimal
  ask              Decimal
  mid              Decimal
  spread           Decimal
  availableVolume  Decimal?
  minOrder         Decimal?
  maxOrder         Decimal?
  completionRate   Decimal?
  paymentMethod    String?
  merchantLimits   Json?
  liquidityScore   Decimal?
  reliabilityScore Decimal?
  dataStatus       String   @default("valid")
  createdAt        DateTime @default(now())

  @@index([assetPair, source])
  @@index([timestamp])
}

model LiquidityDepth {
  id               String   @id @default(uuid())
  timestamp        DateTime
  venue            String
  assetPair        String
  executableVolume Decimal
  bidDepth         Json?
  askDepth         Json?
  venueRanking     Int?
  createdAt        DateTime @default(now())

  @@index([venue, assetPair])
  @@index([timestamp])
}

// ---------- SPRINT 5 CUSTOMER FEEDBACK & RATINGS ----------

model AgentRating {
  id         String   @id @default(uuid())
  tradeId    String   @unique
  agentId    String
  customerId String
  rating     Int
  feedback   String?
  createdAt  DateTime @default(now())

  trade    Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  agent    User     @relation("AgentRatings", fields: [agentId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerFeedback {
  id         String   @id @default(uuid())
  customerId String
  category   String   @default("GENERAL") // GENERAL, SUGGESTION, COMPLAINT
  message    String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ---------- AGENT APPLICATIONS (public sign-up) ----------

model AgentApplication {
  id                     String   @id @default(uuid())
  fullName               String
  email                  String
  phone                  String
  country                String
  stateCity              String
  occupation             String
  linkedIn               String?
  hearAboutUs            String
  ownsOrOperatesBusiness Boolean
  whyAgent               String
  networkSize            String?
  status                 String   @default("PENDING") // PENDING, REVIEWED, APPROVED, REJECTED
  adminNotes             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status])
  @@index([email])
}

// ---------- SPRINT 1: TREASURY LEDGER ----------

enum AccountType {
  BANK
  WALLET
  EXCHANGE
  LIQUIDITY_PROVIDER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BalanceSyncStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  RESERVATION
  RELEASE
  SETTLEMENT
  FEE
  SYNC_ADJUSTMENT
}

enum MarkupType {
  FIXED
  PERCENTAGE
}

// Registry of all company accounts (banks, wallets, exchanges)
model TreasuryAccount {
  id          String        @id @default(uuid())
  accountName String
  provider    String // e.g. GTBank, Binance, OKX, Coinbase, MetaMask
  currency    String // Primary currency of the account
  accountType AccountType
  status      AccountStatus @default(ACTIVE)
  metadata    Json? // Additional provider-specific metadata (account number, address, etc.)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  balances      TreasuryBalance[]
  syncLogs      BalanceSyncLog[]
  debitEntries  LedgerEntry[]     @relation("DebitAccount")
  creditEntries LedgerEntry[]     @relation("CreditAccount")

  @@index([currency])
  @@index([accountType])
  @@index([status])
}

// Per-account, per-currency balance snapshot
model TreasuryBalance {
  id               String   @id @default(uuid())
  accountId        String
  currency         String
  availableBalance Decimal  @default(0)
  reservedBalance  Decimal  @default(0)
  totalBalance     Decimal  @default(0)
  lastUpdated      DateTime @updatedAt

  account TreasuryAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, currency])
  @@index([currency])
}

// Immutable double-entry ledger record — never updated, never deleted
model LedgerEntry {
  id              String          @id @default(uuid())
  reference       String          @unique @default(uuid())
  transactionType LedgerEntryType
  debitAccountId  String? // Account being debited (funds leave)
  creditAccountId String? // Account being credited (funds arrive)
  amount          Decimal
  currency        String
  description     String
  metadata        Json? // Extra context: trade ID, customer ID, sync ID, etc.
  createdAt       DateTime        @default(now())

  debitAccount  TreasuryAccount? @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount TreasuryAccount? @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([currency])
  @@index([transactionType])
  @@index([createdAt])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

// Sync history per provider/account
model BalanceSyncLog {
  id              String            @id @default(uuid())
  provider        String
  accountId       String
  currency        String
  syncedBalance   Decimal?
  previousBalance Decimal?
  status          BalanceSyncStatus
  errorMessage    String?
  syncedAt        DateTime          @default(now())

  account TreasuryAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([provider])
  @@index([syncedAt])
}

// ---------- SPRINT 1: EXCHANGE RATE MANAGEMENT ----------

// Raw provider rates — append-only, never modified
model ExchangeRateProvider {
  id            String   @id @default(uuid())
  providerName  String // e.g. Binance, OKX, exchangerate.host, Manual
  baseCurrency  String
  quoteCurrency String
  providerRate  Decimal
  fetchedAt     DateTime @default(now())

  @@index([baseCurrency, quoteCurrency])
  @@index([providerName])
  @@index([fetchedAt])
}

// Configurable markup rules — one active rule per currency pair
model ExchangeRateMarkup {
  id            String     @id @default(uuid())
  baseCurrency  String
  quoteCurrency String
  markupType    MarkupType @default(FIXED)
  markupValue   Decimal    @default(0)
  isActive      Boolean    @default(true)
  updatedBy     String? // Admin user ID who last changed this
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  @@unique([baseCurrency, quoteCurrency])
  @@index([isActive])
}

// Full audit trail of every quote generated
model ExchangeRateLog {
  id            String   @id @default(uuid())
  providerName  String
  baseCurrency  String
  quoteCurrency String
  providerRate  Decimal
  markupType    String
  markupApplied Decimal
  customerRate  Decimal
  requestedBy   String? // User ID or service name that requested the quote
  createdAt     DateTime @default(now())

  @@index([baseCurrency, quoteCurrency])
  @@index([createdAt])
}

// ---------- VERIFICATION & CASHOUT (from remote) ----------

model VerificationOtp {
  id             String    @id @default(uuid())
  email          String    @unique
  otp            String
  attempts       Int       @default(0)
  resendAttempts Int       @default(0)
  expiresAt      DateTime
  lastSentAt     DateTime  @default(now())
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum CashoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model CashoutRequest {
  id        String        @id @default(uuid())
  agentId   String
  agentName String
  amount    Decimal
  status    CashoutStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  agent User @relation(fields: [agentId], references: [id])
}

// ---------- SPRINT 1: ORGANIZATIONS ----------

model Organization {
  id                    String             @id @default(uuid())
  ownerId               String
  businessName          String
  businessType          String // LLC, CORPORATION, SOLE_PROPRIETOR, PARTNERSHIP, NGO, OTHER
  countryOfRegistration String
  registrationNumber    String?
  industry              String
  businessAddress       String
  city                  String
  state                 String?
  postalCode            String?
  country               String
  contactEmail          String
  contactPhone          String
  website               String?
  authorizedRepName     String
  authorizedRepTitle    String
  status                OrganizationStatus @default(DRAFT)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  owner         User                        @relation("OrgOwner", fields: [ownerId], references: [id])
  members       OrganizationMember[]
  qualification QualificationAssessment?
  kycRequests   KycRequest[]
  kybRequest    KybRequest?
  documents     VerificationDocument[]
  statusHistory VerificationStatusHistory[]
  webhooks      ComplianceWebhook[]

  // Sprint 2: Managed Banking relations
  bankAccount    BankAccount?
  bankingProfile BankingProfile?
  bankEvents     BankAccountEvent[]
  bankSyncLogs   BankAccountSyncLog[]
  bankWebhooks   BankAccountWebhook[]

  @@index([ownerId])
  @@index([status])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrgMembers", fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ---------- SPRINT 1: QUALIFICATION ----------

model QualificationAssessment {
  id                       String                @id @default(uuid())
  organizationId           String                @unique
  hasInternationalPayments Boolean
  expectedMonthlyVolume    Decimal?
  supplierPaymentFrequency String? // WEEKLY, MONTHLY, QUARTERLY, AD_HOC
  countriesOfOperation     String[] // ISO codes
  primaryUseCase           String?
  additionalContext        String?
  outcome                  QualificationOutcome?
  reviewNotes              String?
  reviewedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([outcome])
}

// ---------- SPRINT 1: KYC ----------

model KycRequest {
  id                  String             @id @default(uuid())
  organizationId      String
  userId              String
  fvBankApplicationId String? // ID returned by FV Bank after submission
  fullName            String
  dateOfBirth         DateTime
  nationality         String
  residentialAddress  String
  phone               String
  email               String
  idType              DocumentType
  status              VerificationStatus @default(DRAFT)
  rejectionReason     String?
  additionalInfoNote  String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  expiresAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization  Organization                @relation(fields: [organizationId], references: [id])
  user          User                        @relation("KycUser", fields: [userId], references: [id])
  documents     VerificationDocument[]      @relation("KycDocuments")
  statusHistory VerificationStatusHistory[] @relation("KycHistory")

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([fvBankApplicationId])
}

// ---------- SPRINT 1: KYB ----------

model KybRequest {
  id                     String             @id @default(uuid())
  organizationId         String             @unique
  fvBankApplicationId    String? // ID returned by FV Bank after submission
  companyName            String
  registrationNumber     String
  countryOfIncorporation String
  businessAddress        String
  taxIdentification      String?
  directors              Json? // Array of { name, role, dob, nationality, idDocUrl }
  ubos                   Json? // Array of { name, ownershipPct, nationality, dob }
  status                 VerificationStatus @default(DRAFT)
  rejectionReason        String?
  additionalInfoNote     String?
  submittedAt            DateTime?
  reviewedAt             DateTime?
  expiresAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization  Organization                @relation(fields: [organizationId], references: [id])
  documents     VerificationDocument[]      @relation("KybDocuments")
  statusHistory VerificationStatusHistory[] @relation("KybHistory")

  @@index([organizationId])
  @@index([status])
  @@index([fvBankApplicationId])
}

// ---------- SPRINT 1: VERIFICATION DOCUMENTS ----------

model VerificationDocument {
  id             String       @id @default(uuid())
  organizationId String
  kycRequestId   String?
  kybRequestId   String?
  documentType   DocumentType
  fileUrl        String
  fileName       String
  fileSize       Int
  mimeType       String
  fvBankDocId    String? // ID returned by FV Bank after document upload
  uploadedBy     String // userId
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  kycRequest   KycRequest?  @relation("KycDocuments", fields: [kycRequestId], references: [id])
  kybRequest   KybRequest?  @relation("KybDocuments", fields: [kybRequestId], references: [id])

  @@index([organizationId])
  @@index([kycRequestId])
  @@index([kybRequestId])
}

// ---------- SPRINT 1: STATUS HISTORY ----------

model VerificationStatusHistory {
  id             String   @id @default(uuid())
  organizationId String
  kycRequestId   String?
  kybRequestId   String?
  entityType     String // KYC | KYB | ORGANIZATION
  fromStatus     String?
  toStatus       String
  changedBy      String? // userId or "SYSTEM" or "FV_BANK_WEBHOOK"
  reason         String?
  metadata       Json? // Raw webhook payload or admin notes
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  kycRequest   KycRequest?  @relation("KycHistory", fields: [kycRequestId], references: [id])
  kybRequest   KybRequest?  @relation("KybHistory", fields: [kybRequestId], references: [id])

  @@index([organizationId])
  @@index([kycRequestId])
  @@index([kybRequestId])
  @@index([createdAt])
}

// ---------- SPRINT 1: COMPLIANCE WEBHOOKS ----------

model ComplianceWebhook {
  id             String       @id @default(uuid())
  organizationId String?
  event          WebhookEvent
  payload        Json
  signature      String?
  processed      Boolean      @default(false)
  processedAt    DateTime?
  errorMessage   String?
  retryCount     Int          @default(0)
  createdAt      DateTime     @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([event])
  @@index([processed])
  @@index([createdAt])
}

// ---------- SPRINT 1: NOTIFICATION LOG ----------

model NotificationLog {
  id           String    @id @default(uuid())
  recipientId  String // userId
  channel      String // EMAIL | IN_APP | PUSH
  type         String // KYC_STATUS_UPDATE | KYB_STATUS_UPDATE | QUALIFICATION_RESULT | etc.
  subject      String?
  content      String
  metadata     Json?
  sent         Boolean   @default(false)
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([recipientId])
  @@index([type])
  @@index([createdAt])
}

// ---------- SPRINT 2: MANAGED BANKING ENUMS ----------

enum BankAccountStatus {
  PENDING_CREATION
  CREATING
  ACTIVE
  RESTRICTED
  SUSPENDED
  FROZEN
  CLOSED
}

enum BankAccountSyncType {
  MANUAL
  SCHEDULED
  WEBHOOK
}

enum BankingWebhookEvent {
  ACCOUNT_CREATED
  ACCOUNT_ACTIVATED
  ACCOUNT_SUSPENDED
  ACCOUNT_FROZEN
  ACCOUNT_CLOSED
  BANKING_INFO_UPDATED
}

// ---------- SPRINT 2: MANAGED BANK ACCOUNTS ----------

model BankAccount {
  id               String            @id @default(uuid())
  organizationId   String            @unique
  fvAccountId      String?           @unique
  accountNumber    String
  routingNumber    String
  accountHolder    String
  bankName         String            @default("FV Bank")
  currency         String            @default("USD")
  country          String?           @default("United States")
  swiftBic         String?
  accountReference String?
  status           BankAccountStatus @default(PENDING_CREATION)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankingProfile BankingProfile?
  events         BankAccountEvent[]
  syncLogs       BankAccountSyncLog[]
  webhooks       BankAccountWebhook[]

  @@index([organizationId])
  @@index([fvAccountId])
  @@index([status])
}

// ---------- SPRINT 2: BANK ACCOUNT EVENTS ----------

model BankAccountEvent {
  id             String             @id @default(uuid())
  bankAccountId  String
  organizationId String
  event          String // e.g. ACCOUNT_CREATED, STATUS_CHANGE, WEBHOOK_RECEIVED, SYNC
  source         String // FV_BANK_WEBHOOK | SYSTEM | SYNC | ADMIN
  statusFrom     BankAccountStatus?
  statusTo       BankAccountStatus?
  details        String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
  @@index([organizationId])
  @@index([event])
  @@index([createdAt])
}

// ---------- SPRINT 2: BANKING PROFILES ----------

model BankingProfile {
  id                  String            @id @default(uuid())
  organizationId      String            @unique
  bankAccountId       String            @unique
  bankName            String            @default("FV Bank")
  accountHolder       String
  maskedAccountNumber String // e.g. "•••• 6789"
  accountNumber       String // Encrypted/Stored
  routingNumber       String
  currency            String            @default("USD")
  status              BankAccountStatus @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bankAccountId])
  @@index([status])
}

// ---------- SPRINT 2: BANK ACCOUNT SYNC LOGS ----------

model BankAccountSyncLog {
  id              String              @id @default(uuid())
  bankAccountId   String
  organizationId  String
  syncType        BankAccountSyncType @default(MANUAL)
  status          String // SUCCESS | FAILED | NO_CHANGE
  changesDetected Json?
  errorMessage    String?
  createdAt       DateTime            @default(now())

  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
  @@index([organizationId])
  @@index([createdAt])
}

// ---------- SPRINT 2: BANK ACCOUNT WEBHOOKS ----------

model BankAccountWebhook {
  id             String              @id @default(uuid())
  organizationId String?
  bankAccountId  String?
  event          BankingWebhookEvent
  payload        Json
  signature      String?
  processed      Boolean             @default(false)
  processedAt    DateTime?
  errorMessage   String?
  retryCount     Int                 @default(0)
  createdAt      DateTime            @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([bankAccountId])
  @@index([event])
  @@index([processed])
  @@index([createdAt])
}

// ---------- CUSTOMER WALLET (LEDGER BALANCE) ENUMS ----------

enum WalletTransactionType {
  DEPOSIT // Approved deposit credits the wallet
  TRADE_DEBIT // Funds spent when a trade is processed
  TRADE_REFUND // Refund back to wallet (e.g. trade cancelled/rejected)
  ADJUSTMENT // Manual admin correction
  REVERSAL // Reversal of a prior entry
}

enum DepositStatus {
  PENDING // Customer submitted, awaiting admin confirmation
  UNDER_REVIEW // Admin is reviewing proof
  APPROVED // Funds credited to wallet
  REJECTED // Declined; no credit
  CANCELLED // Customer cancelled before review
}

// One wallet per customer. Holds the authoritative ledger balance.
// availableBalance = spendable now. reservedBalance = held for in-flight trades.
model CustomerWallet {
  id               String   @id @default(uuid())
  customerId       String   @unique
  currency         String   @default("NGN")
  availableBalance Decimal  @default(0)
  reservedBalance  Decimal  @default(0)
  totalDeposited   Decimal  @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([customerId])
}

// Immutable ledger of every wallet balance change. Never updated, never deleted.
model WalletTransaction {
  id               String                @id @default(uuid())
  walletId         String
  customerId       String
  type             WalletTransactionType
  amount           Decimal // Positive = credit, Negative = debit
  currency         String                @default("NGN")
  balanceAfter     Decimal // availableBalance snapshot after this entry
  description      String
  // Optional links to source records for traceability
  depositRequestId String?
  tradeId          String?
  tradeRequestId   String?
  actorId          String? // who caused it (admin/customer/SYSTEM)
  metadata         Json?
  createdAt        DateTime              @default(now())

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}

// A customer-initiated request to fund their wallet. Requires admin approval.
model DepositRequest {
  id              String        @id @default(uuid())
  customerId      String
  amount          Decimal
  currency        String        @default("NGN")
  method          String        @default("BANK_TRANSFER") // BANK_TRANSFER | WIRE | ACH
  reference       String        @unique @default(uuid()) // idempotency / customer-facing ref
  depositBank     String? // Which treasury account the customer paid into
  proofUrl        String? // Uploaded proof of payment
  note            String? // Customer note
  status          DepositStatus @default(PENDING)
  reviewedBy      String? // admin userId
  reviewedAt      DateTime?
  rejectionReason String?
  creditedAmount  Decimal? // Amount actually credited (may differ from requested)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}
