{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts",
    "prisma/seed.ts",
    "test-db.ts"
  ],
  "include": [
    "src/**/*"
  ]
}